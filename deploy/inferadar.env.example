# InfeRadar internal-server configuration.
#
# Copy to /etc/inferadar/inferadar.env, fill in real values, then lock it down:
#     sudo install -m 600 -o <user> -g <user> inferadar.env.example /etc/inferadar/inferadar.env
#
# This format is shared by systemd EnvironmentFile and `source` in
# run-inferadar.sh, so use simple KEY=value lines (no `export`, avoid quotes).
# NEVER commit the real file. The LLM gateway key stays only on this server and
# is never added to GitHub.

# --- LLM gateway (OpenAI-compatible /chat/completions) ---
# Pre-filled for the AMD internal gateway (an Azure API Management front door).
# The client POSTs to {BASE_URL}/chat/completions.
INFERADAR_LLM_BASE_URL=https://llm-api.amd.com/api/v1
INFERADAR_LLM_API_KEY=replace-with-your-subscription-key
INFERADAR_LLM_MODEL=gemini-3.1-pro-preview

# Auth header. The AMD gateway authenticates with an APIM subscription key (the
# bare key, no "Bearer" prefix), so override the defaults. For a standard
# OpenAI-style gateway, delete these two lines (defaults to: Authorization: Bearer <key>).
INFERADAR_LLM_AUTH_HEADER=Ocp-Apim-Subscription-Key
INFERADAR_LLM_AUTH_PREFIX=

# gemini-3.1-pro-preview is a reasoning model: its thinking tokens count against
# the output budget, so give it lots of room (its max output is 64000). The code
# also auto-retries with a doubled budget if the model returns empty content.
INFERADAR_LLM_MAX_TOKENS=64000
# Ceiling the empty-content retry will not exceed (keep <= the model's max output;
# raise to 128000 only for models that support it, e.g. Claude-Opus-4.x).
# INFERADAR_LLM_MAX_TOKENS_CAP=64000
# Extra attempts (with escalated budget) when content comes back empty.
# INFERADAR_LLM_EMPTY_RETRIES=2

# Model alternatives on this gateway (swap INFERADAR_LLM_MODEL):
#   Claude-Opus-4.8        ~3x faster, punchier/curated (supports 128000 output)
#   Claude-Sonnet-4.5      most reliable (health ~99%), fast, cheaper
#   (gemini-3-pro-preview is currently unhealthy on the gateway; use 3.1)

# Optional tuning:
# INFERADAR_LLM_TIMEOUT=300

# --- GitHub access ---
# No GitHub API token is needed here: the JSON is generated by GitHub Actions in
# the cloud (its built-in token can read ROCm repos that block classic PATs).
# This machine only reads that JSON and writes markdown. Git push uses your
# normal credentials (SSH deploy key, or an HTTPS remote with a stored token).

# --- Runtime ---
# Python interpreter that has inferadar installed (e.g. a virtualenv).
PYTHON=/opt/inferadar/.venv/bin/python

# --- Optional toggles ---
# INFERADAR_SKIP_PUSH=0
# INFERADAR_SKIP_CLEANUP=0
