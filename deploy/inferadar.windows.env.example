# Windows Stage-2 configuration.
#
# The installer copies this file to:
#   %LOCALAPPDATA%\InfeRadar\inferadar.env
#
# Fill in the private copy, never this tracked template. The installer restricts
# the private file ACL to the current Windows user.

INFERADAR_LLM_BASE_URL=https://your-endpoint.example/v1
INFERADAR_LLM_API_KEY=replace-with-your-key
INFERADAR_LLM_MODEL=replace-with-model-name

# Override these when the gateway uses a custom bare-key header.
# INFERADAR_LLM_AUTH_HEADER=Authorization
# Windows removes empty environment variables, so use __EMPTY__ for a bare key.
# INFERADAR_LLM_AUTH_PREFIX=__EMPTY__

INFERADAR_LLM_MAX_TOKENS=64000
# INFERADAR_LLM_MAX_TOKENS_CAP=64000
# INFERADAR_LLM_EMPTY_RETRIES=2

# Short retries happen inside one run; Task Scheduler retries the durable
# backlog every 24 hours after longer laptop/VPN/gateway outages.
# INFERADAR_LLM_HTTP_RETRIES=3
# INFERADAR_LLM_RETRY_BASE_SECONDS=2
# INFERADAR_LLM_TIMEOUT=300

# Ignore intentionally unsummarized older/manual windows. Adjust when deploying
# a different clone or when a deeper historical backfill is desired.
INFERADAR_SUMMARY_SINCE=2026-06-28

